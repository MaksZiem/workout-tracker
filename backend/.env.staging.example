# Konfiguracja środowiska testowego (staging). Na serwerze skopiuj do .env obok docker-compose.yml kopii testowej i uzupełnij.
# Sekrety i baza inne niż na produkcji. Prawdziwego pliku nie commituj.

NODE_ENV=production
# Port backendu (tylko localhost, ruch przychodzi przez reverse proxy)
PORT=3001
# Publiczny adres frontendu testowego (CORS)
FRONTEND_URL=https://workout-tracker-test.zmax-dev.pl

# Postgres w Dockerze zakłada bazę i użytkownika z tych wartości.
# DB_HOST i DB_PORT nadpisuje docker-compose.yml.
DB_HOST=localhost
DB_PORT=5432
DB_USER=workout_test
DB_PASS=
DB_NAME=workout_tracker_test
# Zawsze false, schemat tworzą migracje
DB_SYNCHRONIZE=false

# openssl rand -hex 32, inny niż na produkcji
JWT_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Dzienny limit wywołań AI na użytkownika
AI_DAILY_LIMIT_PER_USER=30

# Docker Compose na serwerze
# Osobna nazwa projektu Dockera, żeby test nie mieszał się z produkcją
COMPOSE_PROJECT_NAME=workout-tracker-test
# Wersje obrazów z GHCR: latest albo sha commita
BACKEND_TAG=latest
FRONTEND_TAG=latest
# Porty na 127.0.0.1, na które Caddy przekazuje ruch (inne dla każdej aplikacji i środowiska)
FRONTEND_PORT=3100
BACKEND_PORT=3101
