# Lokalny development. Skopiuj do backend/.env.

PORT=3001
# Adres frontendu (CORS)
FRONTEND_URL=http://localhost:3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=myuser
DB_PASS=
DB_NAME=workout_tracker
# true = TypeORM sam dopasowuje schemat do encji (tylko lokalnie, nigdy na produkcji).
# Domyślnie schemat tworzą migracje: npm run migration:run
DB_SYNCHRONIZE=false

# Dowolny długi losowy ciąg, np. openssl rand -hex 32
JWT_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
