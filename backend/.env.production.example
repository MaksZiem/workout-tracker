# Konfiguracja produkcyjna. Na serwerze skopiuj do backend/.env i uzupełnij.
# Prawdziwego pliku nie commituj.

NODE_ENV=production
# Port backendu (tylko localhost, ruch przychodzi przez reverse proxy)
PORT=3001
# Publiczny adres frontendu (CORS)
FRONTEND_URL=https://workout.example.com

# Bazę i użytkownika zakładasz na serwerze (DEPLOY.md)
DB_HOST=localhost
DB_PORT=5432
DB_USER=workout
DB_PASS=
DB_NAME=workout_tracker
# Na produkcji zawsze false, schemat tworzą migracje
DB_SYNCHRONIZE=false

# openssl rand -hex 32
JWT_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
