@baseUrl = http://localhost:3000

### Sign in as existing user (see users.http to create one first)
# @name signin
POST {{baseUrl}}/auth/signin
content-type: application/json

{
  "email": "maks@mail.com",
  "password": "Haslo123"
}

###

@authToken = {{signin.response.body.access_token}}

### List all exercises
GET {{baseUrl}}/exercise
Authorization: Bearer {{authToken}}

### List exercises filtered by muscle group
GET {{baseUrl}}/exercise?muscleGroup=CHEST
Authorization: Bearer {{authToken}}

### Create an exercise (requires ADMIN role - see users.http to promote a user)
# @name createExercise
POST {{baseUrl}}/exercise
content-type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "Wyciskanie sztangi na ławce płaskiej",
  "muscleGroup": "CHEST"
}

###

@exerciseId = {{createExercise.response.body.id}}

### Create a second exercise in the same muscle group (a likely substitute of the first)
POST {{baseUrl}}/exercise
content-type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "Wyciskanie hantli na ławce płaskiej",
  "muscleGroup": "CHEST"
}

### Create a third, unrelated exercise (different movement - should NOT be picked as a substitute)
POST {{baseUrl}}/exercise
content-type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "Podciąganie na drążku",
  "muscleGroup": "BACK"
}

### Get one exercise
GET {{baseUrl}}/exercise/{{exerciseId}}
Authorization: Bearer {{authToken}}

### Its substitutes, picked by AI on create (each with a short reason)
GET {{baseUrl}}/exercise/{{exerciseId}}/substitutes
Authorization: Bearer {{authToken}}

### Ask AI to pick its substitutes again (admin)
POST {{baseUrl}}/exercise/{{exerciseId}}/substitutes/generate
Authorization: Bearer {{authToken}}

### Reject one substitute picked by AI (admin)
DELETE {{baseUrl}}/exercise/{{exerciseId}}/substitutes/2
Authorization: Bearer {{authToken}}

### Update an exercise (a new name or group re-picks its substitutes)
PATCH {{baseUrl}}/exercise/{{exerciseId}}
content-type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "Wyciskanie sztangi na ławce płaskiej (chwyt szeroki)"
}

### Pick substitutes for exercises that have none yet (add ?all=true to redo the whole catalog)
POST {{baseUrl}}/exercise/substitutes/generate
Authorization: Bearer {{authToken}}

### Where is it used (admin; only unused exercises can be deleted)
GET {{baseUrl}}/exercise/{{exerciseId}}/usage
Authorization: Bearer {{authToken}}

### Delete an exercise (409 when it is used in a workout or template)
DELETE {{baseUrl}}/exercise/{{exerciseId}}
Authorization: Bearer {{authToken}}
