@baseUrl = http://localhost:3000

### Sign in as existing user (see users.http to create one first)
# @name signin
POST {{baseUrl}}/auth/signin
content-type: application/json

{
  "email": "maks@mail.com",
  "password": "Haslo123"
}

###

@authToken = {{signin.response.body.access_token}}

### Generate a full workout plan with Gemini
### Needs at least a few exercises to already exist - seed some via exercise.http first
# @name generatePlan
POST {{baseUrl}}/ai/generate-plan
content-type: application/json
Authorization: Bearer {{authToken}}

{
  "goal": "HYPERTROPHY",
  "daysPerWeek": 4,
  "constraints": "kontuzja barku, unikam wyciskania nad głowę"
}

###

@planId = {{generatePlan.response.body.plan.id}}
@generatedTemplateId = {{generatePlan.response.body.templates.0.id}}

### See the generated plan with all its templates (see plan.http for full plan CRUD)
GET {{baseUrl}}/plan/{{planId}}
Authorization: Bearer {{authToken}}

### Create an empty workout to parse free text into
# @name createWorkout
POST {{baseUrl}}/workout
content-type: application/json
Authorization: Bearer {{authToken}}

{
  "date": "2026-09-23"
}

###

@workoutId = {{createWorkout.response.body.id}}

### Parse a free-text description of a workout into that Workout
POST {{baseUrl}}/ai/parse-workout
content-type: application/json
Authorization: Bearer {{authToken}}

{
  "workoutId": {{workoutId}},
  "text": "dziś przysiad 3x10 80kg, potem wyciskanie 4x8 60kg"
}

### Check the resulting workout (see workout.http for full workout CRUD)
GET {{baseUrl}}/workout/{{workoutId}}
Authorization: Bearer {{authToken}}
