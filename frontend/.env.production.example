# W Dockerze tego pliku nie używasz: BACKEND_URL ustawia docker-compose.yml. Przydaje się tylko przy uruchamianiu bez Dockera.
# Konfiguracja produkcyjna. Na serwerze skopiuj do frontend/.env.production.
# Adres backendu NestJS, używany tylko po stronie serwera Next.js.
# Gdy frontend i backend działają na tym samym serwerze, może zostać localhost.
BACKEND_URL=http://localhost:3001
