# W Dockerze tego pliku nie używasz: BACKEND_URL ustawia docker-compose.yml. Przydaje się tylko przy uruchamianiu bez Dockera.
# Konfiguracja środowiska testowego (staging). W kopii testowej na serwerze skopiuj do frontend/.env.production
# (next build zawsze czyta .env.production).
# Adres backendu testowego, używany tylko po stronie serwera Next.js.
BACKEND_URL=http://localhost:3001
